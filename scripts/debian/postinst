#!/bin/bash

# Sahiplik ve izinleri ayarla
chown -R root:root /opt/offline-inventory
chmod -R 770 /opt/offline-inventory

# Eğer servis dosyası zaten varsa, kaldır ve servisi durdur
if [ -f "/usr/lib/systemd/system/offline-inventory.service" ]; then
    rm -rf /usr/lib/systemd/system/offline-inventory.service 2>/dev/null || true
    systemctl disable offline-inventory.service 2>/dev/null || true
    systemctl stop offline-inventory.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi

# Yeni servis dosyasını oluştur
cat <<EOF > /etc/systemd/system/offline-inventory.service
[Unit]
Description=Offline Inventory Backend Service
[Service]
Type=simple
WorkingDirectory=/opt/offline-inventory
ExecStart=/opt/offline-inventory/offline-inventory
Restart=always
RestartSec=10
SyslogIdentifier=offline-inventory
KillSignal=SIGINT
User=root
Group=root
[Install]
WantedBy=multi-user.target
EOF

# Sistemd işlemlerini gerçekleştir
systemctl daemon-reload
systemctl enable offline-inventory.service
systemctl restart offline-inventory.service
