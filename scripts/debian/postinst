#!/bin/bash

# Sahiplik ve izinleri ayarla
chown -R root:root /opt/codegen
chmod -R 770 /opt/codegen

# Eğer servis dosyası zaten varsa, kaldır ve servisi durdur
if [ -f "/usr/lib/systemd/system/codegen.service" ]; then
    rm -rf /usr/lib/systemd/system/codegen.service 2>/dev/null || true
    systemctl disable codegen.service 2>/dev/null || true
    systemctl stop codegen.service 2>/dev/null || true
    systemctl daemon-reload 2>/dev/null || true
fi

# Yeni servis dosyasını oluştur
cat <<EOF > /etc/systemd/system/codegen.service
[Unit]
Description=Code generator - cli tool

[Service]
Type=simple
WorkingDirectory=/opt/codegen
ExecStart=/opt/codegen/codegen
Restart=always
RestartSec=10
SyslogIdentifier=codegen
KillSignal=SIGINT
User=root
Group=root

[Install]
WantedBy=multi-user.target
EOF

# Sistemd işlemlerini gerçekleştir
systemctl daemon-reload
systemctl enable codegen.service
systemctl restart codegen.service
