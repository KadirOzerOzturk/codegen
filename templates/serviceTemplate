package %s

import (
	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"%s/app/entities"
	"%s/internal/paginator"
	"%s/pkg/utils"
)

// Service interface
type Service interface {
	Create(payload *entities.%s) error
	Index(c *fiber.Ctx) (*paginator.Data, error)
	Show(id *uuid.UUID) (*entities.%s, error)
	Update(id *uuid.UUID, payload *entities.%s) error
	Delete(id *uuid.UUID) error
}

type service struct {
	repository Repository
}

var _ Service = &service{}

func NewService(r Repository) Service {
	return &service{
		repository: r,
	}
}

// Create service
func (s *service) Create(payload *entities.%s) error {
	return s.repository.Insert(payload)
}

// Index service
func (s *service) Index(c *fiber.Ctx) (*paginator.Data, error) {
	return s.repository.List(
		utils.QueryInt(c, "page", 1),
		utils.QueryInt(c, "per_page", 25), c.Query("sort"),
		c.Query("search"), utils.GetFilters("filter", c))
}

// Show service
func (s *service) Show(id *uuid.UUID) (*entities.%s, error) {
	return s.repository.Get(id)
}

// Update service
func (s *service) Update(id *uuid.UUID, payload *entities.%s) error {
	return s.repository.Update(id, payload)
}

// Delete service
func (s *service) Delete(id *uuid.UUID) error {
	return s.repository.Delete(id)
}