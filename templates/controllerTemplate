package {{.Name}}s

import (
	"github.com/gofiber/fiber/v2"
	"github.com/google/uuid"
	"{{.ModuleName}}/app/entities"
	"{{.ModuleName}}/app/services/{{.Name}}"
	"{{.ModuleName}}/internal/validation"
	"{{.ModuleName}}/pkg/di"
)

// Create controller
func Create(c *fiber.Ctx) error {
	// Create scope
	scope := c.Locals("scope").(*di.Scope)
	// Get service
	service, err := di.GetService[{{.Name}}.Service](scope)
	if err != nil {
		return err
	}
	// Parse request body
	var request *entities.{{.CapitalizedName}}
	if err := c.BodyParser(&request); err != nil {
		return err
	}
	// Validate request
	if err = validation.Validate(request); err != nil {
		return err
	}
	// Send request to service
	err = service.Create(request)
	if err != nil {
		return err
	}

	return c.JSON(request)
}

